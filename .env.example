# Copie este arquivo para .env e preencha com seus próprios valores.
# .env nunca deve ser commitado (já está no .gitignore).

# Endpoint do projeto no Azure AI Foundry (usado pelo LLM e pelo sub-agente SQL)
FOUNDRY_PROJ_ENDPOINT=

# URL do servidor MCP da base de conhecimento vetorial (Foundry IQ)
MCP_URL_SRCH=

# Chave de API da Tavily (busca na web)
TAVILY_API_KEY=

# Senha do usuário MySQL usado em src/mysql_usp_databse.py
MYSQL_PASS=
